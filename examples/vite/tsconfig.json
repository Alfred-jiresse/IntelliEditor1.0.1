{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@intellieditor/conformity": ["../../packages/conformity/src/index.ts"],
      "@docx-editor.dev/core/store": ["../../packages/core/src/store/index.ts"]
    }
  },
  "include": ["src", "../shared"]
}
