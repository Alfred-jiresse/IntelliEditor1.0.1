{
  "name": "@intellieditor/conformity",
  "version": "0.1.0",
  "private": true,
  "description": "IntelliEditor conformity engine: checks a DOCX against an institution's thesis norm (UDBL TFC by default). DOM-free.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "intelli-check": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun ./src/cli.ts"
  },
  "dependencies": {
    "@docx-editor.dev/core": "workspace:*"
  }
}
